# VyOS Firewall Configuration
# Generated by Ansible - Do not edit manually

# Zone Definitions
set zone-policy zone management
set zone-policy zone attacker
set zone-policy zone dmz
set zone-policy zone internal
set zone-policy zone wan

# Interface Assignments
set interfaces ethernet eth0 zone-management
set interfaces ethernet eth1 zone-attacker
set interfaces ethernet eth2 zone-dmz
set interfaces ethernet eth3 zone-internal
set interfaces ethernet eth4 zone-wan

# Rule Set: Attacker to DMZ (ALLOW - Required for attack simulation)
set firewall name ATTACKER-TO-DMZ default-action drop
set firewall name ATTACKER-TO-DMZ rule 10 action accept
set firewall name ATTACKER-TO-DMZ rule 10 destination port 80
set firewall name ATTACKER-TO-DMZ rule 10 destination port 443
set firewall name ATTACKER-TO-DMZ rule 10 protocol tcp
set firewall name ATTACKER-TO-DMZ rule 10 description "Allow HTTP/HTTPS from Attacker to DMZ"

# Rule Set: DMZ to Internal (DENY & LOG - Move lateral protection)
set firewall name DMZ-TO-INTERNAL default-action drop
set firewall name DMZ-TO-INTERNAL rule 10 action drop
set firewall name DMZ-TO-INTERNAL rule 10 destination port 389
set firewall name DMZ-TO-INTERNAL rule 10 destination port 445
set firewall name DMZ-TO-INTERNAL rule 10 protocol tcp
set firewall name DMZ-TO-INTERNAL rule 10 log enable
set firewall name DMZ-TO-INTERNAL rule 10 description "DENY SMB/LDAP from DMZ to Internal - Lateral movement blocked"

# Rule Set: DMZ to Internal DB (DENY & LOG)
set firewall name DMZ-TO-INTERNAL rule 20 action drop
set firewall name DMZ-TO-INTERNAL rule 20 destination port 3306
set firewall name DMZ-TO-INTERNAL rule 20 protocol tcp
set firewall name DMZ-TO-INTERNAL rule 20 log enable
set firewall name DMZ-TO-INTERNAL rule 20 description "DENY MySQL from DMZ to Internal"

# Rule Set: Attacker to Internal (DENY - Isolation)
set firewall name ATTACKER-TO-INTERNAL default-action drop
set firewall name ATTACKER-TO-INTERNAL rule 10 action drop
set firewall name ATTACKER-TO-INTERNAL rule 10 log enable
set firewall name ATTACKER-TO-INTERNAL rule 10 description "DENY all traffic from Attacker to Internal"

# Rule Set: Management Access
set firewall name MANAGEMENT-ACCESS default-action drop
set firewall name MANAGEMENT-ACCESS rule 10 action accept
set firewall name MANAGEMENT-ACCESS rule 10 destination port 22
set firewall name MANAGEMENT-ACCESS rule 10 protocol tcp
set firewall name MANAGEMENT-ACCESS rule 10 source address 192.168.100.0/24
set firewall name MANAGEMENT-ACCESS rule 10 description "Allow SSH to Management zone"

# NAT Configuration (WAN access)
set service nat rule 10 description "Outbound NAT"
set service nat rule 10 outbound-interface eth4
set service nat rule 10 source address 10.0.0.0/8
set service nat rule 10 translation address masquerade